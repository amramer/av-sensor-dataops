# Copy to .env (never commit .env). Loaded by docker compose and your shell.

# DVC remote (Cloudflare R2 / AWS S3 / MinIO) - read by DVC's S3 client
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MLflow: local compose server, or a hosted one (e.g. DagsHub)
MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# KPI store for Grafana (defaults to sqlite:///reports/kpi.db)
AVDATA_KPI_DB_URL=postgresql+psycopg://avdata:avdata@localhost:5432/kpi

# Training on Kaggle from Airflow (optional)
# TRAIN_BACKEND=kaggle
# KAGGLE_USERNAME=
# KAGGLE_KEY=
