# Small inference image: ONNX Runtime + FastAPI, no PyTorch.
#   docker build -f docker/Dockerfile.serve -t avdata-api .
#   docker run -p 8000:8000 -v $PWD/models:/app/models:ro avdata-api
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL_PATH=/app/models/detector.onnx \
    MODEL_CARD=/app/models/model_card.json \
    FUSION_CONFIG=/app/models/fusion.json \
    DEMO_DIR=/app/demo

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[serve]" \
    && useradd --create-home --uid 1000 app
# Model, fusion config and demo samples are baked in by CI after `dvc repro`/`dvc pull`
# (or mounted at runtime); docker/Dockerfile.render downloads them instead.
COPY models/ ./models/
COPY demo/ ./demo/
USER app

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "avdata.serve.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
